# Supabase runtime connection string for least-privileged pos_app_runtime role.
DATABASE_URL=postgresql://pos_app_runtime.<project-ref>:<url-encoded-password>@<pooler-host>:5432/postgres

# TLS certificate verification. Download the current project CA from Supabase Dashboard.
PGSSLMODE=verify-full
PGSSLROOTCERT=/etc/fastq-pos/supabase-root-ca.pem

# Generate distinct random values (at least 32 bytes each).
POS_API_TOKEN=replace-with-random-secret
POS_SESSION_SECRET=replace-with-different-random-secret
# Optional: 32 random bytes encoded as 64 hexadecimal characters, required for TOTP.
POS_TOTP_ENCRYPTION_KEY=

HOST=127.0.0.1
PORT=4173
