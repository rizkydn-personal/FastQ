POSTGRES_PASSWORD=replace-with-a-long-random-secret
POS_ADMIN_PASSWORD=replace-with-a-different-long-random-secret
POS_APP_PASSWORD=replace-with-a-different-random-secret
POS_BACKUP_PASSWORD=replace-with-a-different-long-random-secret
DATABASE_URL=postgresql://pos_app:replace-with-a-different-random-secret@127.0.0.1:5432/pos
POS_MIGRATION_DATABASE_URL=postgresql://pos_admin:replace-with-a-different-long-random-secret@127.0.0.1:5432/pos
# Set to verify-full for managed PostgreSQL; add the provider CA PEM path if needed.
PGSSLMODE=
PGSSLROOTCERT=
POS_API_TOKEN=replace-with-at-least-32-random-bytes
POS_SESSION_SECRET=replace-with-another-random-secret-at-least-32-bytes
POS_TOTP_ENCRYPTION_KEY=replace-with-64-hex-characters
PORT=4173
# Set true only when a trusted proxy overwrites X-Real-IP, X-Forwarded-For, and X-Forwarded-Host.
POS_TRUST_PROXY=false
POS_COOKIE_SECURE=true
# Optional fixed LAN printer target (raw ESC/POS, usually TCP port 9100)
POS_PRINTER_HOST=
POS_PRINTER_PORT=9100

# Optional encrypted offsite backup (enable with: docker compose --profile offsite up -d offsite-backup)
# Use a path-style S3 repository URL, e.g. s3:https://s3.us-east-1.amazonaws.com/my-fastq-backups/pos
POS_OFFSITE_RESTIC_REPOSITORY=
POS_OFFSITE_RESTIC_PASSWORD=
POS_OFFSITE_S3_ACCESS_KEY_ID=
POS_OFFSITE_S3_SECRET_ACCESS_KEY=
POS_OFFSITE_S3_REGION=us-east-1
# Choose auto, path, or dns to match the S3-compatible provider.
POS_OFFSITE_S3_BUCKET_LOOKUP=auto
